# Copy to backend/.env and replace the placeholders with your local values.
DATABASE_URL=postgresql+psycopg2://postgres:your-password@localhost:5432/kagaz
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional: needed for AI document classification and structured field extraction.
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional; defaults to storage_data relative to the backend working directory.
DOCUMENT_STORAGE_DIR=storage_data

# Comma-separated browser origins allowed by the backend. Add your deployed frontend origin here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Policy knowledge base (RAG): embeddings, policy validation and the assistant.
# A free key from https://aistudio.google.com/apikey works. See docs/rag.md.
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides (defaults shown). Changing the embedding model needs: python -m scripts.reindex_policies
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# POLICY_RELEVANCE_THRESHOLD=0.55
# POLICY_VALIDATION_CONFIDENCE_THRESHOLD=0.7

# Policy source files in S3. Leave S3_POLICY_BUCKET unset to keep policies on local disk.
# AWS credentials come from the standard boto3 chain (these env vars, ~/.aws, or an IAM role).
# S3_POLICY_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

