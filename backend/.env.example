# Kagaz Backend Configuration Example
# Copy this file to backend/.env and update the values for your environment.

# Database URL for PostgreSQL persistence
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/kagaz

# JWT authentication configuration
# JWT_SECRET must be a shared secret at least 32 bytes (256 bits)
JWT_SECRET=replace_with_a_secure_random_32_byte_secret_key
JWT_ISSUER=kagaz
JWT_AUDIENCE=kagaz-api

# Local document storage directory (defaults to storage_data relative to working dir)
DOCUMENT_STORAGE_DIR=storage_data
